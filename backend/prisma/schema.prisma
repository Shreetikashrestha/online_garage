generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows", "darwin-arm64"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  MECHANIC
  ADMIN
}

enum FuelType {
  PETROL
  DIESEL
  ELECTRIC
  HYBRID
}

enum ServiceType {
  MECHANICAL
  TOWING
  SPARE_PARTS
}

enum BookingStatus {
  PENDING
  ACCEPTED
  EN_ROUTE
  ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  HELD_IN_ESCROW
  RELEASED
  REFUNDED
  FAILED
}

enum PaymentMethod {
  CARD
  WALLET
  CASH
}

enum PaymentTiming {
  PRE_PAY
  POST_PAY
}

enum SOSStatus {
  ACTIVE
  RESPONDING
  RESOLVED
}

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  phone              String?
  passwordHash       String
  name               String?
  role               Role     @default(USER)
  isPhoneVerified    Boolean  @default(false)
  isIdentityVerified Boolean  @default(false)
  identityDocUrl     String?
  avatarUrl          String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  mechanicProfile    MechanicProfile?
  vehicles           Vehicle[]
  bookingsAsUser     Booking[] @relation("UserBookings")
  bookingsAsMechanic Booking[] @relation("MechanicBookings")
  payments           Payment[]
  reviewsWritten     Review[]  @relation("Reviewer")
  reviewsReceived    Review[]  @relation("Reviewee")
  sosAlerts          SOSAlert[]
}

model Vehicle {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id])
  make               String
  model              String
  year               Int
  fuelType           FuelType
  registrationNumber String
  vin                String?
  isPrimary          Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  bookings           Booking[]
}

model MechanicProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id])
  photo             String?
  specialty         String[]
  bio               String?
  yearsOfExperience Int      @default(0)
  rating            Float    @default(0)
  totalReviews      Int      @default(0)
  isReliable        Boolean  @default(false)
  isIdVerified      Boolean  @default(false)
  isAvailable       Boolean  @default(false)
  latitude          Float?
  longitude         Float?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model ServiceCatalog {
  id              String      @id @default(cuid())
  name            String
  description     String?
  serviceType     ServiceType
  basePrice       Float
  hourlyLaborRate Float       @default(0)
  travelFeePerKm  Float       @default(0)
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  bookings        Booking[]
}

model SparePart {
  id              String   @id @default(cuid())
  name            String
  description     String?
  price           Float
  installationFee Float    @default(0)
  certification   String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  compatibilities SparePartCompatibility[]
}

model SparePartCompatibility {
  id           String    @id @default(cuid())
  sparePartId  String
  sparePart    SparePart @relation(fields: [sparePartId], references: [id])
  vehicleMake  String
  vehicleModel String
  yearFrom     Int
  yearTo       Int
}

model Booking {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation("UserBookings", fields: [userId], references: [id])
  mechanicId     String?
  mechanic       User?         @relation("MechanicBookings", fields: [mechanicId], references: [id])
  serviceId      String
  service        ServiceCatalog @relation(fields: [serviceId], references: [id])
  vehicleId      String
  vehicle        Vehicle       @relation(fields: [vehicleId], references: [id])
  status         BookingStatus @default(PENDING)
  scheduledTime  DateTime
  estimatedTotal Float
  finalTotal     Float?
  priceLockedAt  DateTime?
  userLatitude   Float
  userLongitude  Float
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  statusHistory  BookingStatusHistory[]
  payment        Payment?
  review         Review?
  sosAlerts      SOSAlert[]
}

model BookingStatusHistory {
  id        String        @id @default(cuid())
  bookingId String
  booking   Booking       @relation(fields: [bookingId], references: [id])
  status    BookingStatus
  changedAt DateTime      @default(now())
  changedBy String
}

model Payment {
  id                    String        @id @default(cuid())
  bookingId             String        @unique
  booking               Booking       @relation(fields: [bookingId], references: [id])
  userId                String
  user                  User          @relation(fields: [userId], references: [id])
  amount                Float
  status                PaymentStatus @default(PENDING)
  method                PaymentMethod
  paymentTiming         PaymentTiming
  stripePaymentIntentId String?       @unique
  stripeTransferId      String?       @unique
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
}

model Review {
  id         String   @id @default(cuid())
  bookingId  String   @unique
  booking    Booking  @relation(fields: [bookingId], references: [id])
  reviewerId String
  reviewer   User     @relation("Reviewer", fields: [reviewerId], references: [id])
  revieweeId String
  reviewee   User     @relation("Reviewee", fields: [revieweeId], references: [id])
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
}

model SOSAlert {
  id        String    @id @default(cuid())
  bookingId String?
  booking   Booking?  @relation(fields: [bookingId], references: [id])
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  latitude  Float
  longitude Float
  message   String?
  status    SOSStatus @default(ACTIVE)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}
